# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# python
__pycache__/
*.py[cod]

# ML training data and runtime logs should not be committed.
backend/ai-inference-service/xray_prepared/
backend/ai-inference-service/models/xray_request_log.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


/ml/*.pkl
/ml/*.csv
/ml/disease_keywords.json
/data/patient-passes/*.json
